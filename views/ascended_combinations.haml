=h2 'Ascended combinations'
.table-responsive
  %table.table.table-sm.table-junethack{style: "width: auto"}
    %thead
      %tr
        %th Variant
        %th Role
        %th Race
        %th Alignment
        %th Gender
    %tbody
      - $variant_order.each do |variant|
        - combinations = sql_select(@ascended_combinations_sql+" and version = ?", @ascended_combinations_value, variant)
        - combinations.each do |c|
          %tr
            %td= h $variants_mapping[c.version]
            %td= h c.role
            %td= h c.race
            %td= h c.align0
            %td= h c.gender0
