!!! 5
%html{"xmlns:og" => "http://ogp.me/ns#"}
  %head
    %meta{:charset => "utf-8"}/
    %meta{:name => "viewport", :content => "width=device-width, initial-scale=1"}/
    %meta{:name => "format-detection", :content => "telephone=no"}/
    %link{href: "/vendor/bootstrap/bootstrap.min.css", rel: "stylesheet"}/
    %link{href: "/style.css", rel: "stylesheet"}/
    - games_count = Game.where('user_id > 0').count
    - if $tournament_signupstarttime.nil? || Time.now.to_i < $tournament_signupstarttime
      %title= 'Junethack 2026'
    - elsif games_count == 0 then
      %title= "Junethack 2026 - #{User.count} players already registered!"
    - else
      %title= "Junethack 2026 - #{User.count} players registered - #{games_count} games played!"
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Junethack" />
    <meta property="og:url" content="#{request.scheme}://junethack.net/" />
    <meta property="og:description" content="The NetHack Cross-Variant Summer Tournament" />
    <meta property="og:image" content="#{request.scheme}://junethack.net/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Junethack" href="#{request.scheme}://junethack.net/junethack.rss" />
    <link href="/fontawesome/css/fontawesome.css" rel="stylesheet">
    <link href="/fontawesome/css/solid.css" rel="stylesheet">
    <script src="/javascript.js"></script>
  %body.bg-junethack
    %nav.navbar.navbar-expand-lg.shadow
      .container-fluid
        %a.navbar-brand{href: "/"}
          %img.logo{alt: "Home", src: "/logo.png", style: "height: 40px"}/
        %button.navbar-toggler{"type" => "button", "data-bs-toggle" => "collapse", "data-bs-target" => "#mainNav", "aria-controls" => "mainNav", "aria-expanded" => "false", "aria-label" => "Toggle navigation"}
          %span.navbar-toggler-icon
        #mainNav.collapse.navbar-collapse
          %ul.navbar-nav.me-auto
            %li.nav-item.dropdown
              %a.nav-link.dropdown-toggle{"href" => "#", "role" => "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"} Results
              %ul.dropdown-menu
                %li
                  %a.dropdown-item{href: "/scoreboard"} Clan scoreboard
                %li
                  %a.dropdown-item{href: "/trophy_scoreboard"} Trophy scoreboard
                %li
                  %a.dropdown-item{href: "/player_scoreboard"} Player scoreboard
                %li
                  %hr.dropdown-divider
                %li
                  %a.dropdown-item{href: "/ascensions"} Ascensions
                %li
                  %a.dropdown-item{href: "/deaths"} Deaths
                %li
                  %a.dropdown-item{href: "/games"} Games
            %li.nav-item.dropdown
              %a.nav-link.dropdown-toggle{"href" => "#", "role" => "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"} Tournament stats
              %ul.dropdown-menu
                %li
                  %a.dropdown-item{href: "/activity"} Summary
                %li
                  %a.dropdown-item{href: "/clans"} Clans
                %li
                  %a.dropdown-item{href: "/users"} Players
                %li
                  %a.dropdown-item{href: "/servers"} Servers
                - if Time.now.to_i > $tournament_endtime
                  %li
                    %a.dropdown-item{href: "/post_tournament_statistics"} Post Tournament Statistics
            - if ENV["ARCHIVE_MODE"].nil?
              %li.nav-item.dropdown
                %a.nav-link.dropdown-toggle{"href" => "#", "role" => "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"} Archives
                %ul.dropdown-menu
                  - (2011..2025).to_a.reverse.each do |year|
                    %li
                      %a.dropdown-item{href: "/archive/#{year}/index.html"}= "#{year} tournament"
            %li.nav-item.dropdown
              %a.nav-link.dropdown-toggle{"href" => "#", "role" => "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"} About
              %ul.dropdown-menu
                %li
                  %a.dropdown-item{href: "/rules"} Rules
                %li
                  %a.dropdown-item{href: "/trophies"} Trophies
                %li
                  %a.dropdown-item{href: "/authors.txt"} The project
            %li.nav-item
              %a.nav-link{href: "https://nethackwiki.com/wiki/Junethack/FAQ"} FAQ
          %ul.navbar-nav
            - if !@logged_in then
              %li.nav-item
                %a.nav-link{href: "/user/#{@user.login}"}
                  %i.fas.fa-user
              %li.nav-item
                %a.nav-link{href: "/home"}
                  %i.fas.fa-cog
              %li.nav-item
                %a.nav-link{href: "/logout"}
                  %i.fas.fa-sign-out-alt
            - if @logged_in then
              %li.nav-item
                %a.nav-link{href: "/login"}= ENV["ARCHIVE_MODE"].nil? ? "Login" : $tournament_year
    .container
      - if @show_banner
        .text-center.my-4
          .logotitles
            %h1 NetHack Cross-Variant
          %p
            %img.img-fluid{alt: "Logo", src: "/logo-large.png", style: "max-width: 300px"}/
          .logotitles
            %h2 Summer Tournament
      - if !@messages.empty? then
        - for message in @messages
          .alert.alert-info.alert-dismissible.fade.show{role: "alert"}
            = message
            %button.btn-close{"type" => "button", "data-bs-dismiss" => "alert", "aria-label" => "Close"}
      - if !@errors.flatten.empty? then
        - for error in @errors
          .alert.alert-danger.alert-dismissible.fade.show{role: "alert"}
            = error
            %button.btn-close{"type" => "button", "data-bs-dismiss" => "alert", "aria-label" => "Close"}
      =yield
      =haml :footer
    %script{src: "/vendor/bootstrap/bootstrap.bundle.min.js"}
