=h3 'Cross-Variant Progress'
.no-more-tables
  %table.table.table-hover.table-sm.table-junethack
    %thead
      %tr
        %th Variant
        %th{style: 'text-align: right'} Turns (max)
        %th Trophy
        %th Medusa
        %th Ascended
    %tbody
      - $variant_order.each do |variant|
        %tr
          %td{"data-title" => "Name"}= h $variants_mapping[variant]
          - if Game.where(user_id: @user_id, version: variant).count > 0
            %td.table_number{"data-title" => "Turns"}= Game.where(version: variant, user_id: @user_id).maximum(:turns).html_formatted
            %td.small_cell{"data-title" => "Trophies"}= Scoreentry.where(user_id: @user_id, variant: variant).count > 0 ? "yes" : "no"
            %td.small_cell{"data-title" => "Medusa"}= (Game.where(user_id: @user_id, version: variant).any? {|g| g.defeated_medusa? } ? "yes" : "no")
            %td.small_cell{"data-title" => "Ascension"}= (Game.where(user_id: @user_id, version: variant).any? {|g| g.ascended? } ? "yes" : "no")
          - else
            %td
            %td
            %td
            %td
