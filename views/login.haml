.card.junethack-card
  .card-body
    - if (Time.new.to_i > $tournament_endtime)
      %h1.text-center Sorry, this year's tournament has ended.
    - elsif $tournament_signupstarttime.nil?
      %h1.text-center Registration has not opened yet.
    - elsif (Time.new.to_i < $tournament_signupstarttime.to_i)
      %h1.text-center
        =haml :registrationdate
    - else
      %p.text-center
        If you haven't signed up yet,
        %a{:href => "/register"} register here!
      .row.justify-content-center
        .col-md-6.col-lg-4
          %form#login_form{:action => "", :method => "post"}
            .mb-3
              %label.form-label{:for => "username"} Username
              %input#username.form-control{:name => "username", :type => "text", :value => "", :autofocus => "", :placeholder => "username", :required => "required"}/
            .mb-3
              %label.form-label{:for => "password"} Password
              %input#password.form-control{:name => "password", :type => "password", :value => "", :placeholder => "password", :required => "required"}/
            .text-center
              %input#submit.btn.btn-junethack-red{:name => "submit", :type => "submit", :value => "Log in!"}/
