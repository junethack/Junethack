=h3 'Competition'
- $variant_order.each do |variant|
  - @variant = variant
  - entries = CompetitionScoreEntry.where(variant: variant, user_id: @user_id)
  - if (CompetitionScoreEntry.where(user_id: @user_id, variant: @variant).count) > 0
    - trophies = Trophy.user_competition_trophies @variant
    - user_competition_trophies = CompetitionScoreEntry.where(user_id: @player.id, variant: @variant, rank: 1).pluck(:trophy)
    =h4 $variants_mapping[variant], "competition_#{variant}"
    .table-responsive
      %table.table.table-sm.table-junethack.trophies
        %tr
          %th{colspan: 2} Competition
          %th
          %th{style: "padding-right: 0; width: 3em;" } Rank
          - $competition_trophy_order.each do |competition_trophy|
            %tr
              - c = CompetitionScoreEntry.find_by(user_id: @user_id, variant: @variant, trophy: competition_trophy)
              - trophy = Trophy.find_by(variant: c.variant, trophy: c.trophy)
              %td.trophy
                =haml :trophy, locals: {trophy: trophy, achieved: (user_competition_trophies.include? trophy.trophy)}
              %td= h trophy.text
              - if competition_trophy == :fastest_ascension_realtime
                %td.table_number= parse_seconds(c.value)
              - else
                %td.table_number= c.value.html_formatted
              %td.table_number= h c.rank
