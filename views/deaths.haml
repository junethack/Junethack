- cache_fragment(Game.max_endtime) do
  - @deaths = Game.where.not(user_id: nil).select("death, count(1) AS count, group_concat(version) AS versions").group(:death).order("count DESC")
  - @unique_deaths = ActiveRecord::Base.connection.exec_query("SELECT death, count(1) AS count FROM normalized_deaths GROUP BY death ORDER BY count DESC").map { |row| OpenStruct.new(row) }

  .card.junethack-card
    .card-body
      =h2 'All deaths (unfiltered)', 'deaths'
      .table-responsive
        %table.table.table-sm.table-junethack{style: "width: auto"}
          %thead
            %tr
              %th Count
              %th Death
          %tbody
            - @deaths.each do |death|
              %tr
                %td.table_number= death.count
                - variants = (["NH-1.3d"]+$variant_order) & death.versions.split(",").uniq
                - variant_names = variants.map { |v| $variants_mapping[v] }
                %td= h "#{death.death} (#{variant_names.join(", ")})"
    .card-body.border-top
      =h2 'Unique deaths (filtered)', 'unique_deaths'
      %h3= "(eligible for <a href='/trophies#clan-deaths'>Most unique deaths for Clan Competition</a>)"
      .table-responsive
        %table.table.table-sm.table-junethack{style: "width: auto"}
          %thead
            %tr
              %th Count
              %th Death
          %tbody
            - @unique_deaths.each do |death|
              %tr
                %td.table_number= death.count
                %td= h death.death
