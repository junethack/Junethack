#clan_banner.mx-auto
  // TODO add created_at on clan table
  - clan_created_at = Event.where("text = ?", "New clan #{@clan.name} created!").order(created_at: :asc).first&.created_at
  - members_count = User.where(clan_name: @clan.name).count
  - best_rank_entry = ClanScoreHistory.where(clan_name: @clan.name, trophy: 'clan_winner').where.not(rank: -1).order(rank: :asc).first
  - most_points_entry = ClanScoreHistory.where(clan_name: @clan.name, trophy: 'clan_winner').order(points: :desc).first
  - clan_score_entry = ClanScoreEntry.find_by(clan_name: @clan.name, trophy: 'clan_winner')

  = h2 'Clan Info'
  %table.table.table-sm.table-junethack.w-auto
    %tbody
      %tr
        %td.text-muted Created
        %td.table_date
          - if clan_created_at
            #{h clan_created_at.getutc.strftime("%Y-%m-%d")}
          - else
            unknown
      %tr
        %td.text-muted Members
        %td.table_number #{h members_count}
      %tr
        %td.text-muted Rank
        %td.table_number
          - if clan_score_entry
            #{h clan_score_entry.rank}
          - else
            no games
      %tr
        %td.text-muted Clan Points
        %td.table_number
          - if clan_score_entry
            #{h clan_score_entry.points}
          - else
            no games
      - if best_rank_entry
        %tr
          %td.text-muted Best Rank
          %td.table_number
            #{h best_rank_entry.rank}
            %small.text-muted.ms-1 (#{h best_rank_entry.created_at.getutc.strftime("%Y-%m-%d")})
      - if most_points_entry
        %tr
          %td.text-muted Most Points
          %td.table_number
            #{h most_points_entry.points.round(1)}
            %small.text-muted.ms-1 (#{h most_points_entry.created_at.getutc.strftime("%Y-%m-%d")})
