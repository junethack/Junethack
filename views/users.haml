- cache_fragment("#{Game.max_endtime}_#{User.count}_#{Account.count}") do
  .card.junethack-card
    .card-body
      %h3
        All Players
      .table-responsive
        %table.table.table-hover.table-sm.table-junethack
          %thead
            %tr
              %th
                Username
              %th
                Servers
              %th
                Games Played
              %th
                Trophies Earned
          %tbody
            - @users.sort_by {|user| user.login.downcase }.each do |user|
              %tr
                %td
                  %a{:href => "/user/" + user.login}
                    #{h user.login}
                %td
                  #{h user.servers.map(&:url).uniq.count}
                %td
                  #{h user.games_count}
                %td
                  #{h user.scoreentries.count}
