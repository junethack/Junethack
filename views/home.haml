%section
  .card.junethack-card
    .card-body
      %h2 Manage your accounts
      - server_accounts = (Server.all - @user.servers)
      - server_accounts.reject! {|server| server.url =~ /https:\/\/[ae]u.hardfought.org\/nethack/ }
      - server_accounts = server_accounts.map {|server| [server.id, server.hostname] }.uniq {|_,server| server}
      - if server_accounts.size > 0
        .alert.alert-info
          = "Hi #{h @user.login}!  To have your games on one of the <a href='/servers'>supported public servers</a> ranked in the tournament, add the following line<br/><tt># #{h @tournament_identifier}</tt><br/> to your options file on the public server."
        %ul
          %li= "On nethack.alt.org, use the \"NetHack 3.6.7\" nethackrc for all hosted variants there."
          %li= "On nethack4.org, set the interface option \"comment\" and enter your public server account name (case-sensitive) into the form below."
          %li= "On hardfought.org, use the \"NetHack 3.4.3\" nethackrc."
      .table-responsive
        %table.table.table-hover.table-sm.table-junethack
          %thead
            %tr
              %th Server
              %th Account
          %tbody
            - accounts = @user.accounts.map {|acc| [acc.server.hostname, acc.name] }.uniq.sort
            - accounts.each do |server, name|
              %tr.account
                %td= server
                %td= name
      - if server_accounts.size > 0
        %h3.mt-3 Add an account to your name
        %form#add_server_form.row.g-2.align-items-end{action: "/add_server_account", method: "post"}
          .col-auto
            %select.form-select{name: "server"}
              - server_accounts.each do |id, hostname|
                %option{value: id}= hostname
          .col-auto
            %input.form-control{type: "text", name: "user", placeholder: "public server username", autofocus: ""}
          .col-auto
            %input.btn.btn-primary{type: "submit", value: "add account"}

      %hr

      %h2
        Manage your clan
      - if @user.clan
        %img{src: @user.clan.gravatar_link, style: 'vertical-align: middle; width: 2em'}
        %a{:href => "/clan/#{CGI::escape @user.clan.name}"}= @user.clan.name
        %a.btn.btn-outline-danger.btn-sm.ms-2{:href => "/leaveclan"} Leave
      - else
        - unless @user.invitations and @user.invitations.empty?
          %p
            You have
            = @user.invitations.length
            invitation(s)
          .table-responsive
            %table.table.table-sm.table-junethack
              %thead
                %tr
                  %th Clan
                  %th Accept
                  %th Decline
              %tbody
                - for invitation in @user.invitations
                  %tr
                    %td= invitation['clan_id']
                    %td
                      %a.btn.btn-success.btn-sm{:href => "/respond/#{invitation['token']}?accept=true"} Accept
                    %td
                      %a.btn.btn-outline-secondary.btn-sm{:href => "/respond/#{invitation['token']}?accept=false"} Decline
        - else
          %p
            No invitations for this user
    - if not @user.clan
      .card-body.border-top
        %h2 Create a new clan
        %form#create_clan_form.row.g-2.align-items-end{method: "POST", action: "/clan"}
          .col-auto
            %label.form-label{for: "clanname"} Clan name
            %input#clanname.form-control{name: "clanname", type: "text", placeholder: "clan name"}
          .col-auto
            %input.btn.btn-primary{type: "submit", value: "Create clan"}
