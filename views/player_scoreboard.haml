%section
  .card.junethack-card
    .card-body
      %h2
        Player scoreboard
    .card-body#variant_navigation_list
      %ul.list
        - $variant_order.each do |variant|
          - variant_name = $variants_mapping[variant]
          %li
            %a{href: "##{link_id variant_name}"}= variant_name

    - $variant_order.each do |variant|
      - variant_name = $variants_mapping[variant]
      .card-body.border-top
        =h3 variant_name
        - if CompetitionScoreEntry.where(variant:).count == 0
          %div
            No ascensions yet
        - else
          - for i in 0..$competition_trophy_order.size-1 do
            .table-responsive.mb-3
              %table.table.table-sm.table-junethack
                - trophy = Trophy.find_by(variant:, trophy: $competition_trophy_order[i])
                %thead
                  %tr
                    %th.trophy
                      =haml :trophy, locals: { trophy: trophy, achieved: true }
                    %th= trophy.text
                    %th.competition_value
                    %th.competition_placing Rank
                %tbody
                  / only show the first 3 places
                  - trophy_order = $competition_trophy_order[i]
                  - c = CompetitionScoreEntry.where(variant:, trophy: trophy_order).where('rank <= 3').order(rank: :asc)
                  - for j in 0..c.size-1 do
                    %tr
                      - user = User.find(c[j].user_id).login
                      %td{colspan: 2}
                        %a{:href => "/user/" + CGI::escape(user)}=h user
                      - if $competition_trophy_order[i] == :fastest_ascension_realtime
                        %td.table_number= parse_seconds(c[j].value)
                      - else
                        %td.table_number= c[j].value.html_formatted
                      %td.table_number= h c[j].rank
